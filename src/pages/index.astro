---
import '@fontsource-variable/manrope';
import '../styles/error-state-shake.css';

const description = 'Cue brings social comments and messages into one inbox, helps you see what needs attention, and drafts replies for your team to review.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="Cue — Social activity, ready for review." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <title>Cue – Helping teams move faster</title>
  </head>
  <body>
    <main class="stagger">
      <p style="--index: 0">
        <strong>Cue</strong> turns scattered social comments and messages into organized
        work. It started as an internal tool for a client whose team needed a clearer
        way to see what needed attention and respond faster.
      </p>
      <p style="--index: 1">
        Checking every platform separately means urgent complaints can get buried
        under routine questions and spam. Cue is being built to bring that activity
        into one inbox, so your team spends less time sorting messages and more time
        helping the people behind them.
      </p>
      <p style="--index: 2">
        Cue uses AI to identify what someone wants, judge the urgency, and suggest a
        next step. A damaged-order complaint might need a reply from support. A purchase
        question needs an answer. A partnership request needs the right person's attention.
        Cue can draft a response for review, while your team decides what to edit,
        approve, or dismiss.
      </p>
      <p style="--index: 3">
        The open-source demo lets you try this workflow with simulated activity from
        Instagram, TikTok, X, Facebook, and YouTube. It records your decisions inside Cue
        without publishing replies to social accounts.
      </p>

      <section style="--index: 4" aria-label="Waitlist">
        <form id="waitlist" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="2569e911-b4ad-46d1-a61f-54f9e2fd5dff" />
          <input type="hidden" name="subject" value="Cue waitlist signup" />
          <input type="hidden" name="from_name" value="Cue waitlist" />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" aria-hidden="true" />
          <div class="form-row">
            <button id="join-waitlist" type="button" aria-expanded="false" aria-controls="email-field">Join the waitlist<svg class="arrow" width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            <div id="email-field" class="email-field t-input-wrap" hidden>
              <label for="email" class="sr-only">Email address</label>
              <input id="email" class="t-input" name="email" type="email" placeholder="Your email address" autocomplete="email" aria-describedby="email-error" required disabled />
              <p id="email-error" class="t-error-msg" aria-live="polite"></p>
            </div>
          </div>
        </form>
      </section>

      <section style="--index: 5" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <ul class="contact-links">
          <li><a href="mailto:me@jsmalls.net" target="_blank" rel="noopener noreferrer">me@jsmalls.net</a></li>
          <li><a href="https://github.com/jordansmalls/cue" target="_blank" rel="noopener noreferrer">Contribute</a></li>
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { color-scheme: light; background: #fff; }
  :global(body) {
    margin: 0;
    padding: 16px;
    color: #383838;
    font-family: 'Manrope Variable', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.025em;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) { background: #e3e3e3; }
  main { max-width: 700px; }
  .stagger > * {
    opacity: 1;
    transform: translateY(0);
    transition-property: opacity, transform;
    transition-duration: 250ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
    transition-delay: calc(var(--index, 0) * 0.05s);
  }
  @starting-style {
    .stagger > * {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  /* Show focused items immediately. */
  .stagger > :focus-within {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .stagger > * {
      transition: none;
    }
  }
  strong { font-weight: 800; }
  p { margin: 0 0 24px; }
  section { margin-top: 18px; }
  h2 { margin: 0 0 2px; color: #737373; font-size: inherit; font-weight: 600; }
  form { max-width: 470px; }
  .form-row { display: flex; align-items: flex-start; gap: 8px; }
  .email-field { flex: 1; min-width: 0; }
  .email-field:not([hidden]) { animation: reveal-email 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  @keyframes reveal-email {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: translateX(0); }
  }
  input[type='email'].is-error { border-color: #b42318; outline-color: #b42318; }
  .t-error-msg { margin: 6px 0 0; color: #b42318; font-size: 12px; }
  .t-error-msg:empty { margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .email-field:not([hidden]) { animation: reveal-email-fade 150ms ease; }
  }
  @keyframes reveal-email-fade { from { opacity: 0; } to { opacity: 1; } }
  input, button { font: inherit; letter-spacing: inherit; border-radius: 4px; }
  input[type='email'] {
    width: 100%;
    min-width: 0;
    height: 36px;
    padding: 7px 10px;
    border: 1px solid #dedede;
    background: #fff;
    color: inherit;
  }
  input::placeholder { color: #767676; opacity: 1; }
  button {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 36px;
    padding: 7px 10px;
    border: 1px solid transparent;
    background: #f1f1f1;
    color: inherit;
    cursor: pointer;
  }
  .arrow { width: 15px; height: 15px; margin-left: 7px; }
  button:hover:not(:disabled) { background: #e6e6e6; }
  button:disabled { color: #737373; cursor: not-allowed; }
  input:disabled { opacity: 1; cursor: not-allowed; }
  :is(input, button, a):focus-visible { outline: 2px solid #f1f1f1; outline-offset: 3px; }
  .contact-links { display: grid; justify-items: start; gap: 4px; margin: 4px 0 0; padding: 0; list-style: none; }
  .contact-links a { display: inline-flex; align-items: center; gap: 5px; padding: 3px 6px; border-radius: 4px; background: #f1f1f1; color: inherit; text-decoration: none; }
  .contact-links a:hover { background: #e6e6e6; }
  .botcheck { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 480px) {
    .form-row { flex-direction: column; }
    button { align-self: flex-start; }
    .email-field { width: 100%; }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('#join-waitlist')!;
  const field = document.querySelector<HTMLDivElement>('#email-field')!;
  const email = document.querySelector<HTMLInputElement>('#email')!;
  const error = document.querySelector<HTMLParagraphElement>('#email-error')!;

  button.addEventListener('click', (event) => {
    if (!field.hidden) return;
    event.preventDefault();
    field.hidden = false;
    email.disabled = false;
    button.setAttribute('aria-expanded', 'true');
    button.type = 'submit';
    email.focus({ preventScroll: true });
  });

  email.addEventListener('invalid', (event) => {
    event.preventDefault();
    error.textContent = email.validity.valueMissing
      ? 'Enter your email address.'
      : 'Enter a valid email address.';
    email.setAttribute('aria-invalid', 'true');
    field.classList.add('is-error');
    email.classList.add('is-error');
    email.classList.remove('is-shaking');
    void email.offsetWidth;
    email.classList.add('is-shaking');
    email.focus({ preventScroll: true });
  });

  email.addEventListener('animationend', () => email.classList.remove('is-shaking'));
  email.addEventListener('input', () => {
    field.classList.remove('is-error');
    email.classList.remove('is-error', 'is-shaking');
    email.removeAttribute('aria-invalid');
    error.textContent = '';
  });
</script>
