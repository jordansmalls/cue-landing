---
import '@fontsource-variable/manrope';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <title>Page not found — Cue</title>
  </head>
  <body>
    <main><p>What are you doing here?</p></main>
  </body>
</html>

<style>
  :global(html) { color-scheme: light; background: #fff; }
  :global(body) {
    margin: 0;
    color: #383838;
    font-family: 'Manrope Variable', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.025em;
    -webkit-font-smoothing: antialiased;
  }
  main { display: grid; min-height: 100svh; place-items: center; }
  p { margin: 16px; text-align: center; }
</style>
